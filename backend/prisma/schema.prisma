// Plataforma Curso de Python para Ninos (8-10 anos)
// Base de datos: PostgreSQL — ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TUTOR
  VENDEDOR // atiende a los interesados y les crea la cuenta al confirmar el pago
  ESTUDIANTE // cuenta de acceso operada por el estudiante o su acudiente
}

/// Ciclo de vida de un interesado, desde que deja sus datos hasta que se
/// matricula o se descarta.
enum LeadEstado {
  NUEVO
  CONTACTADO
  INSCRITO
  DESCARTADO
}

enum ClassStatus {
  PENDIENTE
  DICTADA
  CANCELADA
}

enum EnrollmentStatus {
  ACTIVO
  RETIRADO
}

enum SuggestionStatus {
  NUEVA
  LEIDA
  ATENDIDA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  NEQUI
  DAVIPLATA
  OTRO
}

/// Que compra un pago. La escuela vende la mensualidad recurrente, pero tambien
/// el curso completo, un modulo suelto o una clase suelta.
enum PaymentType {
  MENSUALIDAD
  CURSO_COMPLETO
  MODULO
  CLASE
}

enum ExpenseCategory {
  PLATAFORMA
  MATERIALES
  PAGO_TUTORES
  MARKETING
  ADMINISTRATIVO
  OTRO
}

// ---------------------------------------------------------------------------
// Usuarios y personas
// ---------------------------------------------------------------------------

/// Cuenta de acceso al sistema. Un ESTUDIANTE aqui representa la cuenta de la
/// familia: dado que los ninos tienen 8-10 anos, normalmente la opera el
/// acudiente. Por eso la persona que toma el curso vive en el modelo `Student`
/// y una misma cuenta puede tener varios hijos vinculados (hermanos).
model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Role     @default(ESTUDIANTE)
  telefono     String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gruposComoTutor      Group[]         @relation("GroupTutor")
  estudiantes          Student[]       @relation("StudentAccount")
  sugerencias          Suggestion[]    @relation("SuggestionAuthor")
  sugerenciasAtendidas Suggestion[]    @relation("SuggestionHandler")
  pagosRegistrados     Payment[]       @relation("PaymentRecorder")
  accesosConcedidos    StudentAccess[] @relation("CourseAccessGranter")
  gastosRegistrados    Expense[]       @relation("ExpenseRecorder")
  interesadosAtendidos Lead[]          @relation("LeadHandler")
  interesadosOrigen    Lead[]          @relation("LeadAccount")

  @@index([rol])
  @@map("users")
}

/// Alguien que dejo sus datos en la pagina publica pidiendo informacion. Todavia
/// no es un usuario: el vendedor lo contacta y, al confirmar el pago, le crea la
/// cuenta. Se guarda aparte de `User` a proposito, para que un interesado que
/// nunca se matricule no ensucie la lista de cuentas ni pueda iniciar sesion.
model Lead {
  id               String     @id @default(cuid())
  /// Datos del acudiente, lo unico que se pide obligatorio.
  nombre           String
  telefono         String
  email            String?
  /// Datos del nino, opcionales: se piden para poder preparar la llamada.
  nombreEstudiante String?
  edadEstudiante   Int?
  mensaje          String?
  estado           LeadEstado @default(NUEVO)
  /// Notas privadas del vendedor sobre la gestion.
  notas            String?
  contactadoEn     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  /// Vendedor que lo esta atendiendo.
  atendidoPorId String?
  atendidoPor   User?   @relation("LeadHandler", fields: [atendidoPorId], references: [id], onDelete: SetNull)

  /// Cuenta creada a partir de este interesado, cuando se matricula.
  userId String?
  user   User?   @relation("LeadAccount", fields: [userId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([createdAt])
  @@map("leads")
}

/// El nino que toma el curso. Se separa de `User` para permitir que un mismo
/// acudiente administre varios estudiantes con una sola cuenta.
model Student {
  id                String    @id @default(cuid())
  nombre            String
  apellido          String?
  fechaNacimiento   DateTime?
  acudienteNombre   String?
  acudienteTelefono String?
  acudienteEmail    String?
  notas             String?
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Cuenta con la que el estudiante/acudiente entra a la plataforma.
  userId String?
  user   User?   @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  inscripciones StudentGroup[]
  asistencias   Attendance[]
  pagos         Payment[]
  accesos       StudentAccess[]

  @@index([userId])
  @@index([activo])
  @@map("students")
}

/// Lo que un estudiante tiene habilitado: un curso completo, un modulo o una
/// clase suelta. Se llena exactamente uno de los tres.
///
/// El acceso efectivo es esta lista UNIDA a los cursos de los grupos donde esta
/// inscrito, para que nunca ocurra que este en un grupo y no pueda ver el
/// curriculo de ese mismo curso.
model StudentAccess {
  id          String   @id @default(cuid())
  concedidoEn DateTime @default(now())
  nota        String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  classId  String?
  clase    Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Pago que lo origino, si vino de una compra y no de una concesion manual.
  origenPagoId String?
  origenPago   Payment? @relation(fields: [origenPagoId], references: [id], onDelete: SetNull)

  concedidoPorId String?
  concedidoPor   User?   @relation("CourseAccessGranter", fields: [concedidoPorId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@unique([studentId, moduleId])
  @@unique([studentId, classId])
  @@index([studentId])
  @@map("student_access")
}

// ---------------------------------------------------------------------------
// Grupos / cohortes
// ---------------------------------------------------------------------------

model Group {
  id            String   @id @default(cuid())
  nombre        String
  diaSemana     String // LUNES, MARTES, ...
  hora          String // "16:00"
  fechaInicio   DateTime
  cupoMaximo    Int?
  /// Enlace fijo de la videollamada semanal (Meet, Zoom...). Es del grupo y no
  /// de cada clase porque la sala se reutiliza todas las semanas.
  enlaceReunion String?
  notas         String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tutorId String?
  tutor   User?   @relation("GroupTutor", fields: [tutorId], references: [id], onDelete: SetNull)

  /// Curso que sigue esta cohorte. Restrict: no se borra un curso con grupos.
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  inscripciones StudentGroup[]
  progreso      GroupProgress[]

  @@index([tutorId])
  @@index([courseId])
  @@map("groups")
}

model StudentGroup {
  id           String           @id @default(cuid())
  fechaIngreso DateTime         @default(now())
  estado       EnrollmentStatus @default(ACTIVO)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([groupId])
  @@map("student_groups")
}

// ---------------------------------------------------------------------------
// Curriculo
// ---------------------------------------------------------------------------

/// Un curso es un programa completo con su propio curriculo (por ejemplo
/// "Python para ninos" o "Scratch"). Cada grupo cursa exactamente un curso, y
/// su avance se mide solo contra las clases de ese curso.
model Course {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  /// Duracion estimada en meses, solo informativa.
  duracionMeses Int?
  /// Rango de edad sugerido, por ejemplo "8 a 10 anos".
  edadSugerida  String?
  color         String? // color de acento para distinguirlo en la interfaz
  activo        Boolean  @default(true)
  orden         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modulos     Module[]
  grupos      Group[]
  accesos     StudentAccess[]
  pagos       Payment[]
  interesados Lead[]

  @@index([orden])
  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  numero      Int
  nombre      String
  objetivo    String
  descripcion String?
  orden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // El curso define 4 clases por modulo, pero el modelo no lo fuerza para
  // poder flexibilizarlo a futuro.
  clases  Class[]
  accesos StudentAccess[]
  pagos   Payment[]

  // La numeracion es por curso: cada curso tiene su propio modulo 1.
  @@unique([courseId, numero])
  @@index([courseId, orden])
  @@map("modules")
}

model Class {
  id              String   @id @default(cuid())
  numeroClase     Int
  nombre          String
  objetivo        String
  contenido       String
  conceptosClave  String[] @default([])
  duracionMinutos Int      @default(60)
  recursosUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progreso GroupProgress[]
  accesos  StudentAccess[]
  pagos    Payment[]

  @@unique([moduleId, numeroClase])
  @@index([moduleId])
  @@map("classes")
}

// ---------------------------------------------------------------------------
// Avance y asistencia
// ---------------------------------------------------------------------------

model GroupProgress {
  id           String      @id @default(cuid())
  estado       ClassStatus @default(PENDIENTE)
  fechaDictada DateTime?
  notas        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classId String
  clase   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  asistencias Attendance[]

  @@unique([groupId, classId])
  @@index([groupId])
  @@map("group_progress")
}

model Attendance {
  id        String   @id @default(cuid())
  asistio   Boolean  @default(false)
  nota      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupProgressId String
  groupProgress   GroupProgress @relation(fields: [groupProgressId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupProgressId, studentId])
  @@index([studentId])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Buzon de sugerencias
// ---------------------------------------------------------------------------

model Suggestion {
  id           String           @id @default(cuid())
  mensaje      String
  estado       SuggestionStatus @default(NUEVA)
  respuesta    String?
  createdAt    DateTime         @default(now())
  respondidaEn DateTime?

  userId String?
  autor  User?   @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: SetNull)

  respondidaPorId String?
  respondidaPor   User?   @relation("SuggestionHandler", fields: [respondidaPorId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([userId])
  @@map("suggestions")
}

// ---------------------------------------------------------------------------
// Modulo financiero (solo ADMIN)
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(cuid())
  monto           Decimal       @db.Decimal(12, 2)
  fecha           DateTime
  metodoPago      PaymentMethod @default(TRANSFERENCIA)
  tipo            PaymentType   @default(MENSUALIDAD)
  /// Periodo que cubre el pago, formato "YYYY-MM". Solo aplica a MENSUALIDAD:
  /// una clase o un curso completo no se renuevan cada mes.
  periodoCubierto String?
  concepto        String?
  nota            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Que habilita el pago. Se llena el que corresponde al `tipo`; una
  // MENSUALIDAD puede no apuntar a nada y renovar lo que el estudiante ya tiene.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  classId  String?
  clase    Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  accesos StudentAccess[]

  registradoPorId String?
  registradoPor   User?   @relation("PaymentRecorder", fields: [registradoPorId], references: [id], onDelete: SetNull)

  // Sin unique en (studentId, periodoCubierto): un periodo puede cubrirse con
  // varios abonos. El estado de cartera suma los pagos del periodo.
  @@index([studentId, periodoCubierto])
  @@index([fecha])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  categoria   ExpenseCategory @default(OTRO)
  descripcion String
  monto       Decimal         @db.Decimal(12, 2)
  fecha       DateTime
  proveedor   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  registradoPorId String?
  registradoPor   User?   @relation("ExpenseRecorder", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([categoria])
  @@map("expenses")
}
