# ---------------------------------------------------------------------------
# Variables de entorno del backend.
# En local: copia este archivo a backend/.env y ajusta los valores.
# En Railway: cargalas en la pestana Variables del servicio.
# ---------------------------------------------------------------------------

# Conexion a PostgreSQL.
# En Railway usa la referencia del plugin Postgres: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cocode?schema=public"

# Clave para firmar los JWT. OBLIGATORIA en produccion.
# Genera una con: openssl rand -base64 48
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# Puerto del servidor. Railway lo inyecta automaticamente.
PORT=4000
NODE_ENV=development

# Origenes permitidos por CORS, separados por comas.
# Si el backend sirve el frontend (despliegue de un solo servicio), deja "*".
CORS_ORIGINS="*"

# Valor de la mensualidad, usado para calcular el estado de cartera.
VALOR_MENSUALIDAD=120000

# Credenciales del primer administrador que crea el seed.
SEED_ADMIN_EMAIL="admin@pythonkids.com"
SEED_ADMIN_PASSWORD="Admin123*"

# Si el administrador YA existe, el seed no le toca la contrasena: cambiar
# SEED_ADMIN_PASSWORD no basta para recuperar el acceso. Arranca una vez con
# RESET_ADMIN_PASSWORD=true para forzar el cambio, y luego quita la variable.
RESET_ADMIN_PASSWORD=false

# Pon SEED_DEMO=false para sembrar solo el curriculo y el admin, sin datos
# de ejemplo (recomendado en produccion).
SEED_DEMO=true

# Con SEED_ON_START=true el servidor siembra la base al arrancar. Sirve para el
# primer despliegue en Railway, donde no hay consola para lanzar comandos
# sueltos. El seed es idempotente, pero conviene apagarlo despues del primer
# arranque para que los despliegues siguientes sean mas rapidos.
SEED_ON_START=false
