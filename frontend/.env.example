# Solo hace falta si el frontend se despliega como servicio aparte del backend.
# Si el backend sirve el build del frontend, dejalo sin definir: se usa /api.
# VITE_API_URL="https://mi-backend.up.railway.app/api"

# Moneda usada para formatear montos en pantalla (codigo ISO 4217).
VITE_MONEDA="COP"

# Backend al que apunta el proxy de Vite en desarrollo.
VITE_PROXY_TARGET="http://localhost:4000"
